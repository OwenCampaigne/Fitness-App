# ── OmniRoute — the local AI gateway the coach talks to ───────────────────────
# The app reaches Claude through ANTHROPIC_BASE_URL=http://localhost:20128/v1,
# so this has to be up for /api/coach to work. Everything else in the app runs
# fine without it; the coach returns a 503 that says so.

[Unit]
Description=OmniRoute AI gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campao
WorkingDirectory=/home/campao
# Loopback only. The inference plane is unauthenticated by default, and this
# machine sits on a home network with whatever else is on it.
Environment=OMNIROUTE_SERVER_HOST=127.0.0.1
ExecStart=/usr/bin/omniroute serve --no-open --no-tray
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
