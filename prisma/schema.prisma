// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Athlete profile (one row) ─────────────────────────────────────────────────
model athlete_profile {
  id                    Int       @id @default(autoincrement())
  age                   Int?
  sex                   String?
  heightCm              Float?
  weightKg              Float?
  goalRace              String?
  goalRaceDate          DateTime?
  fitnessLevel          String?
  injuryHistory         String?
  hrZonesJson           String?
  trainingPacesJson     String?
  keyLiftLoadsJson      String?
  plyoTier              Int?
  plyoTierSource        String?
  plyoTierConfidence    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  currentPainLevel      String    @default("none")
  recoveryContextJson   String?
}

// ── Calibration state (one row) ───────────────────────────────────────────────
model calibration_state {
  id                       Int      @id @default(autoincrement())
  startedOn                DateTime?
  windowEnd                DateTime?
  recoveryBaselineReady    Boolean  @default(false)
  anchorConfidenceJson     String?
  graduated                Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

// ── Field tests ───────────────────────────────────────────────────────────────
model field_tests {
  id              Int      @id @default(autoincrement())
  type            String
  date            DateTime
  result          String
  derivedEstimate String?
  createdAt       DateTime @default(now())
}

// ── Readiness (one row per day from Garmin) ───────────────────────────────────
model readiness_daily {
  id                 Int      @id @default(autoincrement())
  date               DateTime @unique
  recoveryScore      Float?
  hrv                Float?
  hrvBaseline        Float?
  rhr                Float?
  rhrBaseline        Float?
  sleepScore         Float?
  sleepHours         Float?
  bodyBattery        Float?
  stress             Float?
  trainingReadiness  Float?
  createdAt          DateTime @default(now())
}

// ── Activities (every run from Garmin) ────────────────────────────────────────
model activities {
  id                Int      @id @default(autoincrement())
  date              DateTime
  type              String
  durationMin       Float?
  distanceKm        Float?
  avgHr             Float?
  maxHr             Float?
  avgPaceSecPerKm   Float?
  splits            String?
  cadence           Float?
  elevationM        Float?
  trimp             Float?
  decoupling        Float?
  garminActivityId  String?  @unique
  createdAt         DateTime @default(now())

  @@index([date])
}

// ── Session (today's prescription, editable) ─────────────────────────────────
model session {
  id               Int      @id @default(autoincrement())
  date             DateTime @unique
  status           String   @default("draft")
  version          Int      @default(1)
  blocksJson       String
  sourceOfLastEdit String?
  // Load currency (framework §3): session load = duration(min) x sRPE(0-10).
  plannedDurationMin Float?
  plannedLoad        Float?
  actualDurationMin  Float?
  srpe               Float?
  actualLoad         Float?
  completedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── Set logs (granular strength log) ─────────────────────────────────────────
model set_logs {
  id         Int      @id @default(autoincrement())
  sessionId  Int
  exerciseId String
  setNumber  Int
  weightKg   Float?
  reps       Int?
  rir        Int?
  rpe        Float?
  notes      String?
  // Phase 4/5: the same table logs plyo contacts and prehab/stretch holds.
  itemId     String?
  itemKind   String   @default("exercise")
  contacts   Int?
  holdSec    Int?
  // Plyo execution quality: both drive the tier anchor, and neither is derivable
  // from load. Previously encoded as a tagged prefix in `notes`.
  cleanExecution  Boolean?
  sorenessNextDay Int?
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([itemId])
}

// ── Edit history (every change to a session) ─────────────────────────────────
model edit_history {
  id        Int      @id @default(autoincrement())
  sessionId Int
  version   Int
  actor     String
  diffJson  String
  reason    String?
  // A move spans two sessions: an add on the destination and a remove on the
  // source. Undoing one alone leaves the item on both days or on neither, so
  // the pair shares a groupId and must be reversed together.
  groupId   String?
  timestamp DateTime @default(now())

  @@index([sessionId])
  @@index([groupId])
}

// ── Exercise library (strength exercises) ────────────────────────────────────
model exercise_library {
  id              String  @id
  name            String
  primaryMuscles  String
  secondaryMuscles String
  equipment       String
  level           String?
  mechanic        String?
  force           String?
  category        String?
  instructions    String
  images          String
  muscleText      String?
  rationale       String?
  evidence        String?
  source          String  @default("free-exercise-db")
}

// ── Plyo library ──────────────────────────────────────────────────────────────
model plyo_library {
  id              String  @id
  name            String
  intensity       String?
  contactLoad     String?
  progressionTier Int
  prerequisites   String?
  target          String?
  videoUrl        String?
  muscleText      String?
  rationale       String?
  evidence        String?
}

// ── Prehab library ────────────────────────────────────────────────────────────
model prehab_library {
  id            String  @id
  name          String
  bodyRegion    String
  category      String
  niggleTags    String
  targetTissue  String?
  videoUrl      String?
  muscleText    String?
  rationale     String?
  evidence      String?
}

// ── Stretch library ───────────────────────────────────────────────────────────
model stretch_library {
  id          String  @id
  name        String
  type        String
  target      String?
  whenToUse   String
  durationSec Int?
  reps        Int?
  muscleText  String?
  rationale   String?
}

// ── Plan (periodized training plan) ──────────────────────────────────────────
model plan {
  id                         Int      @id @default(autoincrement())
  goalRace                   String?
  phase                      String?
  weekInBlock                Int?
  weeklyVolumeTargetKm       Float?
  intensityDistributionJson  String?
  updatedAt                  DateTime @updatedAt
}

// ── Planned session ───────────────────────────────────────────────────────────
model planned_session {
  id              Int      @id @default(autoincrement())
  date            DateTime
  modality        String
  targetSpecJson  String?
  priority        String   @default("B")
  createdAt       DateTime @default(now())

  @@index([date])
}

// ── Preferences (learned + explicit user preferences) ─────────────────────────
model preferences {
  id         Int      @id @default(autoincrement())
  rule       String
  source     String
  confidence Float    @default(1.0)
  weight     Float    @default(1.0)
  // The preference graph: what the rule is about, where it came from, and what
  // it replaced. A preference stated in chat months ago may no longer be true,
  // so supersession is first-class rather than a silent overwrite.
  scope         String?
  subject       String?
  sourceQuote   String?
  statedOn      DateTime?
  supersededById Int?
  active        Boolean  @default(true)
  confirmedAt   DateTime?
  lastAppliedOn DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, scope])
}

// ── Decision log (the agent's memory) ────────────────────────────────────────
model decision_log {
  id                     Int      @id @default(autoincrement())
  date                   DateTime
  recommendedSessionJson String
  rationale              String?
  readinessAtDecision    String?
  wasFollowed            Boolean?
  athleteOverride        String?
  createdAt              DateTime @default(now())

  @@index([date])
}

// -- Niggle tracker (Phase 4, framework SS9) ----------------------------------
// Self-reported soreness/irritation. Descriptive only -- never a diagnosis (SS15).
model niggle_log {
  id              Int       @id @default(autoincrement())
  date            DateTime
  bodyRegion      String
  side            String?
  severity        Int
  quality         String?
  notes           String?
  status          String    @default("active")
  firstReportedOn DateTime
  resolvedOn      DateTime?
  escalatedOn     DateTime?
  createdAt       DateTime  @default(now())

  @@index([date])
  @@index([bodyRegion, status])
}

// -- Garmin structured-workout write-back log (Phase 6) -----------------------
model garmin_push_log {
  id               Int      @id @default(autoincrement())
  sessionId        Int
  date             DateTime
  status           String
  garminWorkoutId  String?
  payloadJson      String?
  error            String?
  createdAt        DateTime @default(now())

  @@index([sessionId])
}

// -- Personal records / maxes (lifts and runs) --------------------------------
// Dated on purpose: a 5k PR from two years ago is not evidence of today's
// fitness, and the engine must be able to discount by age rather than treat
// every record as current.
model personal_records {
  id          Int      @id @default(autoincrement())
  kind        String
  subjectId   String
  label       String
  value       Float
  unit        String
  reps        Int?
  achievedOn  DateTime
  source      String   @default("logged")
  sessionId   Int?
  verified    Boolean  @default(false)
  supersededById Int?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([kind, subjectId, achievedOn])
}

// -- Clearance history --------------------------------------------------------
// Clearance changes as rehab progresses. Keeping the history means the app can
// show when a restriction lifted and who lifted it, instead of only the latest
// snapshot inside recoveryContextJson.
model clearance_history {
  id             Int      @id @default(autoincrement())
  recordedOn     DateTime
  clearanceJson  String
  stage          String
  setBy          String
  sourceQuote    String?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([recordedOn])
}

// -- Weekly training summary --------------------------------------------------
// A rolled-up week, written once the week closes, so trend and history views do
// not re-derive from every set log each time they render.
model week_summary {
  id             Int      @id @default(autoincrement())
  weekStart      DateTime @unique
  totalLoad      Float?
  runKm          Float?
  runMinutes     Float?
  strengthSets   Int?
  plyoContacts   Int?
  sessionsPlanned Int?
  sessionsDone   Int?
  acwrEnd        Float?
  summaryJson    String?
  createdAt      DateTime @default(now())
}
