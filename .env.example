# ──────────────────────────────────────────────────────────────────────────────
# Garmin Health Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Garmin Connect credentials (required for real data) ──────────────────────
# Without these the app falls back to realistic mock/demo data automatically.
GARMIN_USERNAME=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# ── Garmin OAuth tokens (required only if your account has MFA/2FA enabled) ──
# Generate once with: node scripts/get-garmin-tokens.js
# The script handles the MFA email code interactively and auto-adds tokens to Vercel.
# Tokens last ~90 days; re-run the script when they expire.
# When these are set, username/password are used only for display (not for auth).
GARMIN_OAUTH1=
GARMIN_OAUTH2=

# ── Anthropic API key (optional — powers the AI weekly summary) ───────────────
# Get yours at: https://console.anthropic.com/settings/keys
# If not set, the AI Summary card is simply hidden. The rest of the app works normally.
ANTHROPIC_API_KEY=sk-ant-...

# ── Web Push / VAPID keys (optional — enables push notifications) ─────────────
# Generate with: node scripts/generate-vapid-keys.js
# If not set, push notifications are disabled but the app works normally.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your@email.com

# ── Cron sync secret (required for /api/sync endpoint security) ───────────────
# Set a random string here and configure cron-job.org to send it as the
# ?secret= query param (or x-cron-secret header). Prevents unauthorized syncs.
# Generate: openssl rand -hex 32
CRON_SECRET=replace-with-random-string

# ── Scenario mode (dev only — bypasses DB, returns preset readiness data) ─────
# Set to one of: green_day | amber_day | red_day | high_acwr | calibrating | pain_flagged
# Never set this in production — getScenario() returns null when NODE_ENV=production.
# SCENARIO=green_day

# ── Strength scenario mode (dev only — fabricates logged lifting history) ─────
# Set to one of: strength_fresh | strength_progressing | strength_stalled | strength_overreached
# Independent of SCENARIO above: pair them to test e.g. an amber day mid-progression.
# Never set this in production.
# STRENGTH_SCENARIO=strength_progressing

# ── Run scenario mode (dev only — fabricates ladder state and pace anchors) ───
# Set to one of: run_ladder_early | run_ladder_ready | run_ladder_capped |
#                run_ladder_pain | run_graduated | run_no_anchors | run_no_clearance
# Never set this in production.
# RUN_SCENARIO=run_ladder_ready
